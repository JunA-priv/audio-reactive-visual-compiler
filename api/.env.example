# Copy to api/.env for local development. The default mode does not call OpenAI.
BLUEPRINT_MODE=fixture
API_ADDR=127.0.0.1:8080
AUTH_ENV=local
# Hosted mode requires the exact canonical Hosted Supabase issuer and HTTPS.
# CORS_ALLOWED_ORIGINS is a comma-separated exact HTTPS origin allowlist; never use *.
CORS_ALLOWED_ORIGINS=
OPENAI_MODEL=gpt-6-luna

# Optional Audio Analyze route. Requires CPU Python Island, explicit JWT trust,
# and the dedicated quota DB role. Both process and database switches must enable it.
AUDIO_ANALYSIS_ENABLED=false
# Async jobs are opt-in until migrations 050b/050d/050e are applied.
AUDIO_ANALYSIS_JOBS_ENABLED=false
# local uses the existing PostgreSQL polling worker. cloud_tasks requires Cloud Run
# service identities, a private worker, Cloud Tasks queue, Scheduler wake trigger,
# and the unapplied 050e migration; do not enable from this local example.
AUDIO_ANALYSIS_TRANSPORT=local
AUDIO_ANALYSIS_CLOUD_TASKS_ENABLED=false
ARVC_SERVICE_ROLE=api
# Cloud Tasks profile only; values are non-secret resource identities/URLs.
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=
CLOUD_SCHEDULER_SERVICE_ACCOUNT=
AUDIO_WORKER_URL=
AUDIO_API_URL=
# Required when Audio Analyze is enabled: dedicated arvc_audio_analysis DB role.
# Remote DSNs require sslmode=verify-full. DB defaults deny until service policy and
# explicit per-user entitlement are configured. Never put this DSN in VITE_ settings.
SUPABASE_AUDIO_ANALYSIS_DSN=
PYTHON_ISLAND_EXECUTABLE=../python-island/.venv/bin/python-island
PYTHON_ISLAND_DIRECTORY=../python-island
FFPROBE_EXECUTABLE=ffprobe

# Optional server-side credentials. Keep blank for Fixture mode.
# Put a real value only in ignored api/.env after external use is authorized.
OPENAI_API_KEY=
AI_GENERATION_ENABLED=false
# Local-only quota/budget/concurrency bypass for one verified account, Fixture mode only.
# Both values must remain disabled/empty unless explicitly enabled in ignored api/.env.
AI_FIXTURE_UNLIMITED_LOCAL=false
AI_FIXTURE_UNLIMITED_USER_ID=

# Enable only when the repository's localhost Supabase stack and Step 7b
# migration are ready. The anon key is a public local project key, not a service_role key.
PROJECTS_ENABLED=false
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_ANON_KEY=replace-with-local-anon-key

# Dedicated local DB role used only to finalize byte-verified Asset uploads.
# Set with sslmode=disable on local loopback; remote connections require verify-full.
# Never put this value in Frontend settings or Git.
SUPABASE_ASSET_VERIFIER_DSN=

# Dedicated server-only role for atomic AI entitlement/quota reservation.
# Keep AI generation disabled until migration 016 is applied locally and this
# DSN points to arvc_ai_budget on loopback. Never reuse the Asset Verifier role.
SUPABASE_AI_BUDGET_DSN=

# Optional test-only local Supabase administrator key. Never set this for the Go API.
# Required only by local Auth integration tests to create and remove temporary users.
# SUPABASE_SERVICE_ROLE_KEY=
