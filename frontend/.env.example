# Local Supabase only. These are local URL and public anon/publishable key values.
# Never put service_role, secret keys, or database credentials in VITE_ variables.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Optional public API HTTPS origin for hosted builds; blank keeps Vite /api proxy routing.
VITE_API_BASE_URL=
# Keep false until the API durable queue migration and worker are enabled.
VITE_AUDIO_ANALYSIS_JOBS_ENABLED=false
