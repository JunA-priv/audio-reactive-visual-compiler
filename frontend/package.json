    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
