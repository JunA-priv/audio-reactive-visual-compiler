# Copy to test.env. This profile isolates app ports, not the local Supabase DB/Auth.
ARVC_ENV=test
ARVC_FRONTEND_PORT=5174
API_ADDR=127.0.0.1:8081
PORT=
ARVC_API_PROXY_TARGET=http://127.0.0.1:8081
AUTH_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_API_BASE_URL=
BLUEPRINT_MODE=fixture
AI_GENERATION_ENABLED=false
PROJECTS_ENABLED=false
AUDIO_ANALYSIS_ENABLED=false
AUDIO_ANALYSIS_JOBS_ENABLED=false
AI_FIXTURE_UNLIMITED_LOCAL=false
SUPABASE_AI_BUDGET_DSN=
SUPABASE_ASSET_VERIFIER_DSN=
# Only set a test-only local role DSN after explicit test DB provisioning and entitlement setup.
SUPABASE_AUDIO_ANALYSIS_DSN=
