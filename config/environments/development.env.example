# Copy to development.env. Plain KEY=VALUE; shell expansion and quoting are not supported.
ARVC_ENV=development
ARVC_FRONTEND_PORT=5173
ARVC_VITE_HOST=0.0.0.0
API_ADDR=127.0.0.1:8080
PORT=
