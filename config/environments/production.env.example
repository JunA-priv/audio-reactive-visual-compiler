# Configuration checklist only. Never deploy from this file or commit real secrets.
ARVC_ENV=production
ARVC_PUBLIC_FRONTEND_ORIGIN=https://YOUR-APP.example.com
VITE_API_BASE_URL=https://YOUR-API.example.com
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-hosted-public-anon-key
AUTH_ENV=hosted
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
